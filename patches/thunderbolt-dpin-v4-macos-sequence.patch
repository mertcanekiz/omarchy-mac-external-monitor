+	.pclk_div_sel = 0x5,
+	.lfclk_ctrl = 0x5,
+	.vclk_op_divn = 0x2,
+	.plla_clkout_vreg_bypass = true,
+	.txa_ldoclk_bypass = true,
+	.txa_div2_en = false,
