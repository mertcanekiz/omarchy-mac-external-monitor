# The first entry is the already-installed display-altmode experiment.
menuentry 'Omarchy - external monitor test (manual)' --id 'omarchy-display-test' {
    load_video
    set gfxpayload=keep
    insmod gzio
    insmod part_gpt
    insmod btrfs
    search --no-floppy --fs-uuid --set=root 725346d2-f127-47bc-b464-9dd46155e8d6
    echo 'Loading existing Asahi kernel for display test ...'
    linux /@/boot/vmlinuz-linux-asahi root=UUID=725346d2-f127-47bc-b464-9dd46155e8d6 rw rootflags=subvol=@ loglevel=4
    echo 'Loading separate display-test initramfs ...'
    initrd /@/boot/initramfs-display-test.img
}

# The USB4 test remains manual and does not alter GRUB's saved/default entry.
menuentry 'Omarchy - Asahi USB4 bring-up (manual)' --id 'omarchy-usb4-test' {
    load_video
    set gfxpayload=keep
    insmod gzio
    insmod part_gpt
    insmod btrfs
    search --no-floppy --fs-uuid --set=root 725346d2-f127-47bc-b464-9dd46155e8d6
    echo 'Loading Asahi 7.2.2 Apple USB4 test kernel ...'
    linux /@/boot/vmlinuz-thunderbolt-test root=UUID=725346d2-f127-47bc-b464-9dd46155e8d6 rw rootflags=subvol=@ loglevel=7
    echo 'Loading private USB4 test initramfs ...'
    initrd /@/boot/initramfs-thunderbolt-test.img
}

# Fixed-route J313/front-port DP-IN experiment. Requires its matching m1n1 bundle.
menuentry 'Omarchy - Thunderbolt DP-IN experiment (manual)' --id 'omarchy-thunderbolt-dpin' {
    load_video
    set gfxpayload=keep
    insmod gzio
    insmod part_gpt
    insmod btrfs
    search --no-floppy --fs-uuid --set=root 725346d2-f127-47bc-b464-9dd46155e8d6
    linux /@/boot/vmlinuz-thunderbolt-test root=UUID=725346d2-f127-47bc-b464-9dd46155e8d6 rw rootflags=subvol=@ loglevel=7 thunderbolt.dprx_timeout=-1
    initrd /@/boot/initramfs-thunderbolt-dpin.img
}

# PIODMA boot fix; requires the matching v2 m1n1 bundle.
menuentry 'Omarchy - Thunderbolt DP-IN v2 (manual)' --id 'omarchy-thunderbolt-dpin-v2' {
    load_video
    set gfxpayload=keep
    insmod gzio
    insmod part_gpt
    insmod btrfs
    search --no-floppy --fs-uuid --set=root 725346d2-f127-47bc-b464-9dd46155e8d6
    linux /@/boot/vmlinuz-thunderbolt-test root=UUID=725346d2-f127-47bc-b464-9dd46155e8d6 rw rootflags=subvol=@ loglevel=7 thunderbolt.dprx_timeout=-1
    initrd /@/boot/initramfs-thunderbolt-dpin-v2.img
}

# Stock Asahi GPU plus Apple USB4 backport; requires the matching m1n1 bundle.
menuentry 'Omarchy - Asahi 7.1 GPU + USB4 (manual)' --id 'omarchy-usb4-gpu-test' {
    load_video
    set gfxpayload=keep
    insmod gzio
    insmod part_gpt
    insmod btrfs
    search --no-floppy --fs-uuid --set=root 725346d2-f127-47bc-b464-9dd46155e8d6
    linux /@/boot/vmlinuz-usb4-gpu-test root=UUID=725346d2-f127-47bc-b464-9dd46155e8d6 rw rootflags=subvol=@ loglevel=7
    initrd /@/boot/initramfs-usb4-gpu-test.img
}

# DP-IN v3: 7.1 GPU + USB4 kernel with the external DCP routed into a CIO DP IN
# adapter; holds DP tunnels open (dprx_timeout=-1) and logs thunderbolt debug.
menuentry 'Omarchy - Asahi 7.1 USB4 DP-IN v3 (manual)' --id 'omarchy-usb4-dpin-v3' {
    load_video
    set gfxpayload=keep
    insmod gzio
    insmod part_gpt
    insmod btrfs
    search --no-floppy --fs-uuid --set=root 725346d2-f127-47bc-b464-9dd46155e8d6
    linux /@/boot/vmlinuz-usb4-gpu-test root=UUID=725346d2-f127-47bc-b464-9dd46155e8d6 rw rootflags=subvol=@ loglevel=7 thunderbolt.dprx_timeout=-1 thunderbolt.dyndbg=+p
    initrd /@/boot/initramfs-usb4-dpin-v3.img
}

# DP-IN v4: same 7.1 GPU + USB4 kernel as v3 with the macOS-trace-faithful DP-IN
# bring-up (appledrm + phy-apple-atc modules, atc-dpin DT nodes). Holds DP
# tunnels open (dprx_timeout=-1) and logs thunderbolt debug.
menuentry 'Omarchy - Asahi 7.1 USB4 DP-IN v4 (manual)' --id 'omarchy-usb4-dpin-v4' {
    load_video
    set gfxpayload=keep
    insmod gzio
    insmod part_gpt
    insmod btrfs
    search --no-floppy --fs-uuid --set=root 725346d2-f127-47bc-b464-9dd46155e8d6
    linux /@/boot/vmlinuz-usb4-gpu-test root=UUID=725346d2-f127-47bc-b464-9dd46155e8d6 rw rootflags=subvol=@ loglevel=7 thunderbolt.dprx_timeout=-1 thunderbolt.dyndbg=+p
    initrd /@/boot/initramfs-usb4-dpin-v4.img
}
