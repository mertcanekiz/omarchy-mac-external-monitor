+	dev_info(dcp->dev, "DP-IN auto connect (tunnel up on host DP IN %u): %d\n", in_port, ret);
+	if (ret == -ENODEV && dcp->dpin_hotplug_retries++ < DPIN_HOTPLUG_RETRIES)
+		schedule_delayed_work(&dcp->dpin_hotplug_work, HZ / 2);
