@@ -106,7 +106,8 @@ static void apple_crtc_atomic_enable(struct drm_crtc *crtc,
 	struct drm_crtc_state *crtc_state;
 	crtc_state = drm_atomic_get_new_crtc_state(state, crtc);
 
-	if (crtc_state->active_changed && crtc_state->active) {
